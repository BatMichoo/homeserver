<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps that target it edge to edge: on a phone the
         status and navigation bars would cover the page's header and bottom
         nav. Opting out keeps the page between the bars; fullscreen video
         still hides them. The opt-out is ignored from targetSdk 36, which
         will need the root padded with the system bars' insets instead. -->
    <style name="Theme.HomeServer" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
