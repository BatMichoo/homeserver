{
  "name": "homeserver",
  "networks": {
    "default": {
      "name": "homeserver_default",
      "ipam": {}
    }
  },
  "services": {
    "auth": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "environment": {
        "DB_HOST": "db",
        "DB_NAME": "auth",
        "DB_PASS": "",
        "DB_USER": "auth",
        "HTTPS_PORT": "443",
        "LAN_DOMAIN": "",
        "SESSION_TTL": "720h"
      },
      "networks": {
        "default": null
      },
      "build": {
        "context": "/code/repos/Homeserver/auth",
        "dockerfile": "Dockerfile"
      },
      "depends_on": {
        "db-setup": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-qO-",
          "http://127.0.0.1:8080/healthz"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 6,
        "start_period": "10s"
      }
    },
    "certs": {
      "restart": "no",
      "command": null,
      "entrypoint": null,
      "environment": {
        "CITY": "",
        "COUNTRY_ISO": "",
        "LAN_DOMAIN": "",
        "LAN_IP": "",
        "ORG_NAME": "",
        "OUT_GID": "1000",
        "OUT_UID": "1000",
        "PROVINCE": ""
      },
      "labels": {
        "homeserver.every": "720h"
      },
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "ca-data",
          "target": "/ca",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/code/repos/Homeserver/nginx/certs",
          "target": "/out",
          "bind": {}
        }
      ],
      "build": {
        "context": "/code/repos/Homeserver/certs",
        "dockerfile": "Dockerfile"
      }
    },
    "db": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_PASSWORD": ""
      },
      "image": "postgres:16-alpine",
      "labels": {
        "homeserver.backup": "postgres"
      },
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "db-data",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 10
      }
    },
    "db-setup": {
      "restart": "no",
      "command": null,
      "entrypoint": [
        "/db/setup.sh"
      ],
      "environment": {
        "AUTH_DB_PASSWORD": "",
        "PGHOST": "db",
        "PGPASSWORD": "",
        "PGUSER": "postgres"
      },
      "image": "postgres:16-alpine",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/code/repos/Homeserver/db",
          "target": "/db",
          "read_only": true,
          "bind": {}
        }
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        }
      }
    },
    "nginx": {
      "restart": "unless-stopped",
      "command": [
        "nginx",
        "-c",
        "/etc/nginx/main/nginx.conf",
        "-g",
        "daemon off;"
      ],
      "entrypoint": null,
      "environment": {
        "HTTPS_PORT": "443"
      },
      "image": "nginx:stable-alpine",
      "labels": {
        "homeserver.check": "nginx -t -c /etc/nginx/main/nginx.conf",
        "homeserver.reload": "nginx -s reload -c /etc/nginx/main/nginx.conf",
        "homeserver.tls": "443"
      },
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/code/repos/Homeserver/nginx/main",
          "target": "/etc/nginx/main",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/code/repos/Homeserver/nginx/sites",
          "target": "/etc/nginx/sites",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/code/repos/Homeserver/nginx/snippets",
          "target": "/etc/nginx/snippets",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/code/repos/Homeserver/nginx/templates",
          "target": "/etc/nginx/templates",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/code/repos/Homeserver/nginx/certs",
          "target": "/etc/nginx/certs",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/code/repos/Homeserver/www/html",
          "target": "/var/www/html",
          "read_only": true,
          "bind": {}
        }
      ],
      "depends_on": {
        "auth": {
          "condition": "service_started",
          "required": true
        },
        "certs": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1/rootCA.crt"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 6,
        "start_period": "10s"
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "80",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "tcp"
        }
      ]
    }
  },
  "volumes": {
    "ca-data": {
      "name": "homeserver_ca-data"
    },
    "db-data": {
      "name": "homeserver_db-data"
    }
  }
}