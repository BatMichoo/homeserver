# Home CA certificate: who it's issued to (certs/issue-certs.sh)
COUNTRY_ISO=
PROVINCE=
CITY=
ORG_NAME=
# Domain the home server is reached at, e.g. homeserver.lan. Apps live on
# its subdomains (auth.homeserver.lan, ...). Goes into the certificate.
LAN_DOMAIN=
# This server's LAN IP; also goes into the certificate.
LAN_IP=
# Owner of the files the certs container writes to nginx/certs (default 1000).
# CERTS_UID=
# CERTS_GID=
# Where the TV app's APK is published (default ./.deploy/tv).
# TV_APP_DIR=
# Ports nginx listens on (default 80 and 443).
# HTTP_PORT=
# HTTPS_PORT=

# Postgres superuser password (only db-setup uses it).
POSTGRES_PASSWORD=
# Password of the auth service's database role.
AUTH_DB_PASSWORD=
# How long a login lasts without use (default 720h = 30 days, at least 1h).
# SESSION_TTL=

# --- Media (media/, Jellyfin, Transmission) ---
# The folder on the media drive: downloads/ and library/ go in it (made by
# make up). It must be one filesystem with hard links (ext4, btrfs, xfs;
# not exFAT, FAT or NTFS). Default: ./media-data in this checkout.
MEDIA_DIR=
# Owner of the files in it (default 1000, the usual first user).
# MEDIA_UID=
# MEDIA_GID=
# Group that owns the Intel GPU device, for Jellyfin's video conversion:
#   stat -c %g /dev/dri/renderD128
RENDER_GID=
# vaapi (default): convert video on the Intel GPU; none: on the CPU (slow;
# for a server without a GPU, or if conversion fails).
# JELLYFIN_HWACCEL=
# Password of the media app's database role.
MEDIA_DB_PASSWORD=
# Jellyfin's service account (the media app creates it; nobody logs in).
JELLYFIN_USER=media
JELLYFIN_PASSWORD=
# Transmission's login (only the media app uses it).
TRANSMISSION_USER=media
TRANSMISSION_PASSWORD=
# Port other peers reach Transmission on (open on the host; default 51413).
# TRANSMISSION_PEER_PORT=

# --- Expenser (expenser/) ---
# Password of Expenser's database role.
EXPENSER_DB_PASSWORD=
# Where Expenser is reached, e.g. https://expenser.homeserver.lan (add
# :<port> when HTTPS_PORT isn't 443). Reminder emails link to it; empty:
# emails without links.
EXPENSER_APP_URL=
# Signs the snooze links in reminder emails: at least 32 bytes, e.g.
# openssl rand -hex 32. Moving from Expenser's own server: its JWT_SECRET,
# so links in emails already sent keep working.
EXPENSER_LINK_SECRET=
# Reminder emails (without EXPENSER_SMTP_HOST they're only logged). Gmail:
# smtp.gmail.com, port 587, your address as user, and an app password
# (Google account > Security > 2-Step Verification > App passwords).
EXPENSER_SMTP_HOST=
# EXPENSER_SMTP_PORT=587
EXPENSER_SMTP_USER=
EXPENSER_SMTP_PASSWORD=
# Defaults to the user; may include a name, e.g. Expenser <you@gmail.com>
EXPENSER_SMTP_FROM=
# Reads receipts and suggests pack sizes (Google Gemini).
EXPENSER_GEMINI_API_KEY=
# The household's time zone (default Europe/Sofia), how often bill
# reminders are checked (default 1h, at least 30m), and when reminder emails
# may be sent (default 09:00-18:00, every day, weekends too).
# EXPENSER_TIMEZONE=
# EXPENSER_REMINDER_CHECK_INTERVAL=
# EXPENSER_REMINDER_HOURS=
