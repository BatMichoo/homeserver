# Home CA certificate: who it's issued to (certs/issue-certs.sh)
COUNTRY_ISO=
PROVINCE=
CITY=
ORG_NAME=
# Domain the home server is reached at, e.g. homeserver.lan. Apps live on
# its subdomains (auth.homeserver.lan, ...). Goes into the certificate.
LAN_DOMAIN=
# This server's LAN IP; also goes into the certificate.
LAN_IP=
# Owner of the files the certs container writes to nginx/certs (default 1000).
# CERTS_UID=
# CERTS_GID=
# Ports nginx listens on (default 80 and 443).
# HTTP_PORT=
# HTTPS_PORT=

# Postgres superuser password (only db-setup uses it).
POSTGRES_PASSWORD=
# Password of the auth service's database role.
AUTH_DB_PASSWORD=
# How long a login lasts without use (default 720h = 30 days, at least 1h).
# SESSION_TTL=

# --- Media (media/, Jellyfin, Transmission) ---
# The folder on the media drive: downloads/ and library/ go in it (made by
# make up). It must be one filesystem with hard links (ext4, btrfs, xfs;
# not exFAT, FAT or NTFS). Default: ./media-data in this checkout.
MEDIA_DIR=
# Owner of the files in it (default 1000, the usual first user).
# MEDIA_UID=
# MEDIA_GID=
# Group that owns the Intel GPU device, for Jellyfin's video conversion:
#   stat -c %g /dev/dri/renderD128
RENDER_GID=
# vaapi (default): convert video on the Intel GPU; none: on the CPU (slow;
# for a server without a GPU, or if conversion fails).
# JELLYFIN_HWACCEL=
# Password of the media app's database role.
MEDIA_DB_PASSWORD=
# Jellyfin's service account (the media app creates it; nobody logs in).
JELLYFIN_USER=media
JELLYFIN_PASSWORD=
# Transmission's login (only the media app uses it).
TRANSMISSION_USER=media
TRANSMISSION_PASSWORD=
# Port other peers reach Transmission on (open on the host; default 51413).
# TRANSMISSION_PEER_PORT=
